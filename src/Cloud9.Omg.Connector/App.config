<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <!-- Keep disabled until OMG and Cloud9 approve credentials and sandbox testing. -->
    <add key="Enabled" value="false" />
    <add key="OmgStoreType" value="company" />
    <add key="OmgBaseUrl" value="https://replace-with-company-store-host" />
    <add key="OmgApplicationToken" value="" />

    <add key="Cloud9BaseUrl" value="https://apidev.cloud9express.com/v9.2/ShipService" />
    <add key="Cloud9UserId" value="" />
    <add key="Cloud9Password" value="" />
    <add key="Cloud9LocationId" value="0" />
    <add key="Cloud9ShopCode" value="" />
    <add key="Cloud9CarrierScac" value="" />
    <add key="Cloud9CarrierServiceCode" value="" />
    <add key="Cloud9PaymentType" value="PRE" />

    <add key="CallbackListenUrl" value="http://localhost:8090/" />
    <add key="Cloud9CallbackToken" value="" />
    <add key="DatabasePath" value="storage\omg-connector.db" />

    <add key="PollIntervalMinutes" value="15" />
    <add key="PollOverlapSeconds" value="300" />
    <add key="InitialLookbackHours" value="24" />
    <add key="PageSize" value="100" />
    <add key="OrderNumberPrefix" value="OMG-" />
    <!-- Confirm the client's fulfillment trigger with OMG before production. -->
    <add key="EligibleOrderStatuses" value="new,paid" />
    <add key="SendShippingConfirmation" value="false" />

    <add key="ShipFromContact" value="Shipping Desk" />
    <add key="ShipFromCompany" value="Cloud9 Express" />
    <add key="ShipFromAddress1" value="" />
    <add key="ShipFromAddress2" value="" />
    <add key="ShipFromCity" value="" />
    <add key="ShipFromState" value="" />
    <add key="ShipFromPostalCode" value="" />
    <add key="ShipFromCountry" value="US" />
    <add key="ShipFromPhone" value="" />

    <!-- OMG does not provide final packed dimensions; these are staging defaults. -->
    <add key="DefaultPackageWeight" value="1.0" />
    <add key="DefaultPackageLength" value="10" />
    <add key="DefaultPackageWidth" value="8" />
    <add key="DefaultPackageHeight" value="4" />
    <add key="DefaultPackagingType" value="CP" />
  </appSettings>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>
